# LOCAL DEVELOPMENT ONLY. Copy to local.properties (gitignored, never used
# in CI). In GitHub Actions, secrets come from repo Secrets instead (see
# README.md -> "GitHub Secrets"). Environment variables always take
# priority over this file when both are present.

sdk.dir=/path/to/your/Android/sdk

# Currency/geo lookup uses ipapi.co, which needs no API key — nothing to
# set here for that.

# Optional: only needed to test SIGNED release builds locally.
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
